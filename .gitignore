**/contracts/cache/

# Foundry dependencies. Installed rather than committed, so the repository
# contains only this project's own code:
#   cd rfq-dapp/contracts && forge install foundry-rs/forge-std
**/contracts/lib/

# Secrets. Each project also ignores this; belt and braces.
.env
*.pem
*.key

