# Copy to .env and fill in. .env is gitignored; keep it that way.
#
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------- RPC URLs
# Local anvil, standalone or forking. To work against real chain state:
#   anvil --fork-url https://...
# A fork is still reached as the local network, so nothing else changes.
LOCAL_RPC_URL=http://127.0.0.1:8545

SEPOLIA_RPC_URL=

# ------------------------------------------------------------------- keys
# The three below are anvil's first accounts. These keys are published in
# anvil's own documentation and are known to everyone, so they are safe to
# commit in an example file and useless anywhere but a local node.
#
# NEVER put a key with real funds in this file. For Sepolia, use a wallet
# that holds nothing but test ETH.

# anvil[0] 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# anvil[1] 0x70997970C51812dc3A010C7d01b50e0d17dc79C8
DEALER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# anvil[2] 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
CLIENT_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# ------------------------------------------------------------- verification
# Not read by anything automatically. foundry.toml has no [etherscan] block,
# so pass it explicitly if you verify a Sepolia deployment:
#   forge verify-contract ... --etherscan-api-key "$ETHERSCAN_API_KEY"
ETHERSCAN_API_KEY=
